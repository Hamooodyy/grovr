{
  "expo": {
    "name": "Grovr",
    "slug": "grovr",
    "version": "1.0.0",
    "scheme": "grovr",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.grovr.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f5ead8"
        }
      ]
    ]
  }
}
